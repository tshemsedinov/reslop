{
  "name": "reslop",
  "version": "0.1.0",
  "description": "Interactive code review and repair planning for AI-assisted changes",
  "keywords": [
    "code-review",
    "git",
    "diff",
    "ai",
    "llm",
    "coding-agent",
    "repair-plan",
    "human-in-the-loop",
    "tui",
    "code-quality",
    "developer-tools",
    "deslop",
    "neuroslop",
    "agent",
    "agentic",
    "vibecoding",
    "sdd",
    "planning",
    "security-review",
    "quality-review",
    "maintenability",
    "refactoring"
  ],
  "homepage": "https://github.com/tshemsedinov/reslop",
  "bugs": {
    "url": "https://github.com/tshemsedinov/reslop/issues"
  },
  "license": "MIT",
  "author": "Timur Shemsedinov <timur.shemsedinov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tshemsedinov/reslop.git"
  },
  "main": "lib/api.js",
  "bin": {
    "reslop": "bin/reslop.js"
  },
  "files": [
    "bin/",
    "lib/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "enable": "node scripts/enable.js",
    "disable": "node scripts/disable.js",
    "lint": "eslint . && prettier -c \"**/*.js\" \"**/*.json\" \"**/*.md\"",
    "fix": "eslint . --fix && prettier --write \"**/*.js\" \"**/*.json\" \"**/*.md\"",
    "test": "npm run -s lint && node --test test/*.test.js"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-metarhia": "^9.1.9",
    "metaskills": "^1.0.5",
    "prettier": "^3.8.4"
  },
  "dependencies": {
    "metautil": "^5.5.2"
  }
}
