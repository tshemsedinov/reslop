{
  "label": "Project Tasks: Feature requests, Improvements, Bug reports, Refactoring, Research, Security",
  "kinds": [
    {
      "id": "features",
      "title": "Feature requests and Enhancements",
      "short": "Features",
      "fields": ["problem", "expected", "do", "check"]
    },
    {
      "id": "improvements",
      "title": "Improvements",
      "short": "Improvements",
      "fields": ["where", "problem", "expected", "check"]
    },
    {
      "id": "bugs",
      "title": "Bug Reports and Fixes",
      "short": "Bug Reports",
      "fields": ["where", "problem", "expected", "check"]
    },
    {
      "id": "debt",
      "title": "Refactoring and Technical debt",
      "short": "Refactoring",
      "fields": ["where", "problem", "do", "check"]
    },
    {
      "id": "research",
      "title": "Research and Experiments",
      "short": "Research",
      "fields": ["problem", "expected", "related"]
    },
    {
      "id": "security",
      "title": "Security and Compliance",
      "short": "Security",
      "fields": ["where", "problem", "do", "check"]
    }
  ],
  "fields": [
    {
      "key": "where",
      "hot": "w",
      "hint": "path, path:line, path#symbol"
    },
    {
      "key": "problem",
      "hot": "p",
      "hint": "what is wrong now: symptom, log, failing test"
    },
    { "key": "expected", "hot": "e", "hint": "how it behaves when done" },
    {
      "key": "do",
      "hot": "d",
      "hint": "the approach and what must not change"
    },
    { "key": "check", "hot": "c", "hint": "acceptance criteria" },
    { "key": "related", "hot": "r", "hint": "specs, task IDs, URLs" },
    { "key": "result", "hint": "what changed and how it was verified" }
  ]
}
